# Copia como .env (no se versiona) y carga con:
#   export $(grep -v '^#' .env | xargs)     # Linux / macOS
#
# En Cloud Run, Railway o similar, se ponen como variables de entorno del
# servicio en vez de en un archivo.

# URL publica de ESTE servidor. Sin ella el hub no sabe a donde entregar.
# La conoceras despues del primer despliegue.
RELAY_URL_PUBLICA=https://relay-server-xxxxxx.a.run.app

# Tres cadenas aleatorias DISTINTAS. Genera cada una con:
#   openssl rand -hex 32
WEBSUB_SECRETO=
WEBSUB_TOKEN_CALLBACK=
TOKEN_INTERNO=

# Clave de la YouTube Data API v3.
YOUTUBE_API_KEY=

# Origen del panel de curaduria, separado por comas si hay varios.
CORS_ORIGENES=http://localhost:5000

# Credenciales de Firebase. Dentro de Google Cloud no hace falta: se toman del
# entorno. Fuera, apunta al service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json

# Apple, solo si publicas en App Store.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.tuempresa.creatorhub
# Contenido del .p8 en una sola linea, con \n literales en los saltos.
APPLE_CLAVE_PRIVADA=

# Ponlo en false si despliegas en Cloud Run con escalado a cero.
RENOVACION_PROGRAMADA=true
